generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum TourCategory {
  COOKING_CLASS
  WINE_TOUR
  WINTER_TOUR
}

enum PriceTierType {
  ADULT
  CHILD
  INFANT
}

model Tour {
  id                      String                   @id @default(cuid())
  slug                    String                   @unique
  title                   String
  category                TourCategory
  summary                 String
  description             String
  heroImageUrl            String?
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  priceTiers              PriceTier[]
  customQuestions         CustomQuestion[]
  seasonalAvailabilities  SeasonalAvailability[]
  dateOverrides           DateOverride[]
  bookings                Booking[]
  bookingHolds            BookingHold[]
}

model PriceTier {
  id         String        @id @default(cuid())
  tourId     String
  tour       Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  type       PriceTierType
  priceCents Int
  minPersons Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([tourId, type])
}

model CustomQuestion {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  question  String
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SeasonalAvailability {
  id        String   @id @default(cuid())
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  capacity  Int
  createdAt DateTime @default(now())
}

model DateOverride {
  id               String   @id @default(cuid())
  tourId           String
  tour             Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  isBlocked        Boolean  @default(false)
  capacityOverride Int?
  createdAt        DateTime @default(now())

  @@unique([tourId, date])
}

model GlobalBlackout {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  reason    String?
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Booking {
  id            String               @id @default(cuid())
  tourId        String
  tour          Tour                 @relation(fields: [tourId], references: [id])
  date          DateTime             @db.Date
  status        BookingStatus        @default(PENDING)
  customerName  String
  customerEmail String
  totalCents    Int
  couponId      String?
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  participants  BookingParticipant[]
  hold          BookingHold?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model BookingParticipant {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tier      PriceTierType
  count     Int

  @@unique([bookingId, tier])
}

model BookingHold {
  id                String   @id @default(cuid())
  tourId            String
  tour              Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  participantsCount Int
  expiresAt         DateTime
  bookingId         String?  @unique
  booking           Booking? @relation(fields: [bookingId], references: [id])
  createdAt         DateTime @default(now())
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Int
  isActive  Boolean    @default(true)
  expiresAt DateTime?
  bookings  Booking[]
  createdAt DateTime   @default(now())
}

model TransferRoute {
  id          String               @id @default(cuid())
  origin      String
  destination String
  priceCents  Int
  maxPax      Int
  maxLuggage  Int
  isActive    Boolean              @default(true)
  supplements TransferSupplement[]
  createdAt   DateTime             @default(now())
}

model TransferSupplement {
  id              String        @id @default(cuid())
  transferRouteId String
  transferRoute   TransferRoute @relation(fields: [transferRouteId], references: [id], onDelete: Cascade)
  label           String
  priceCents      Int
  createdAt       DateTime      @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AdminNote {
  id        String   @id @default(cuid())
  subject   String
  content   String
  createdAt DateTime @default(now())
}
